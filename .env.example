# OpenAI (분류·요약·임베딩·챗봇에 필요). 실제 값은 .env 에만 넣고 커밋하지 않는다.
OPENAI_API_KEY=

# 선택: 모델 교체 (기본값)
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-6-astra

# 선택: 튜닝 (기본값)
# RAG_MIN_SCORE=0.27            # 챗봇 검색 유사도 하한 (scripts/calibrate_threshold.py로 측정)
# RELEVANCE_REJECT_CONF=0.7     # 보안 무관으로 숨길 최소 확신도
# PIPELINE_MAX_ENRICH=300       # 한 번에 분류·요약할 기사 수 상한
# ENRICH_WORKERS=4              # 분류·요약 병렬 호출 수
